<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>ICommandor</PackageId>
    <Version>4.0.0</Version>
    <Authors>Nodirbek Abdulaxadov</Authors>
    <Description>A lightweight CQRS/Mediator library for .NET with automatic caching and Roslyn source generation. Supports plain-type query parameters, GetAsync semantic alias, and auto-generated ICommandor extension methods.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cqrs;mediator;source-generator;caching;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/Nodirbek-Abdulaxadov/Commandor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Nodirbek-Abdulaxadov/Commandor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Commandor.Generators\Commandor.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <Target Name="PackGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Commandor.Generators\Commandor.Generators.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />

    <ItemGroup>
      <None Include="..\Commandor.Generators\bin\$(Configuration)\netstandard2.0\Commandor.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="..\Commandor.Generators\bin\$(Configuration)\netstandard2.0\Commandor.Generators.pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('..\\Commandor.Generators\\bin\\$(Configuration)\\netstandard2.0\\Commandor.Generators.pdb')" />
    </ItemGroup>
  </Target>

</Project>
