<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <PackageId>ICommandor</PackageId>
    <Description>A lightweight CQRS/Mediator library for .NET with automatic caching and Roslyn source generation. 2.0 adds auto-generated cached proxies — inject the service directly and every [QueryHandler] method is cached transparently, every [CommandHandler] method auto-invalidates.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cqrs;mediator;source-generator;caching;dotnet;proxy;interception</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Commandor.Generators\Commandor.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <Target Name="PackGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Commandor.Generators\Commandor.Generators.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />

    <ItemGroup>
      <None Include="..\Commandor.Generators\bin\$(Configuration)\netstandard2.0\Commandor.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="..\Commandor.Generators\bin\$(Configuration)\netstandard2.0\Commandor.Generators.pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('..\\Commandor.Generators\\bin\\$(Configuration)\\netstandard2.0\\Commandor.Generators.pdb')" />
    </ItemGroup>
  </Target>

</Project>
